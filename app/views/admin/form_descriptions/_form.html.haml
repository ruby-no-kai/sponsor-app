= form_with(model: form_description, url: [@conference, form_description], local: true) do |form|
  - if form_description.errors.any?
    .alert.alert-danger
      %p #{pluralize(form_description.errors.count, "error")} prohibited this from being saved:
      %ul
        - form_description.errors.full_messages.each do |message|
          %li= message

  .form-group
    = form.label :locale
    = form.text_field :locale, class: 'form-control'

  - FormDescription::MARKDOWN_FIELDS.each do |field|
    .form-group
      = form.label field
      = form.text_area field, class: 'form-control'

  .form-group
    = form.label :fallback_options
    = form.text_area :fallback_options, class: 'form-control', value: @fallback_options_json || fallback_options_json(form_description.fallback_options), rows: 10
    %small.form-text
      An rubykaigi.sponsor_app.internal.FallbackOptions message as JSON:
      %code {"options": [{"value": "gold", "name": "Change to Gold", "conditions": [{"plans": ["Platinum"], "booth_request": true}], "priority_human": ["Gold"]}]}

  .form-group
    = form.submit class: 'btn btn-primary'
