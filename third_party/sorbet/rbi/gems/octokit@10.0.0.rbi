# pkg:gem/octokit#lib/octokit/response/feed_parser.rb:8
class Octokit::Response::FeedParser < ::Faraday::Response::Middleware
  # pkg:gem/octokit#lib/octokit/response/feed_parser.rb:9
  def on_complete(env); end
end

# pkg:gem/octokit#lib/octokit/response/raise_error.rb:11
class Octokit::Response::RaiseError < ::Faraday::Response::Middleware
  # pkg:gem/octokit#lib/octokit/response/raise_error.rb:12
  def on_complete(response); end
end

# pkg:gem/octokit#lib/octokit/error.rb:303
class Octokit::SAMLProtected < ::Octokit::Forbidden; end

# pkg:gem/octokit#lib/octokit/error.rb:346
class Octokit::ServerError < ::Octokit::Error; end

# pkg:gem/octokit#lib/octokit/error.rb:358
class Octokit::ServiceUnavailable < ::Octokit::ServerError; end

# pkg:gem/octokit#lib/octokit/error.rb:279
class Octokit::TooLargeContent < ::Octokit::Forbidden; end

# pkg:gem/octokit#lib/octokit/error.rb:275
class Octokit::TooManyLoginAttempts < ::Octokit::Forbidden; end

# pkg:gem/octokit#lib/octokit/error.rb:271
class Octokit::TooManyRequests < ::Octokit::Forbidden; end

# pkg:gem/octokit#lib/octokit/error.rb:237
class Octokit::Unauthorized < ::Octokit::ClientError; end

# pkg:gem/octokit#lib/octokit/error.rb:343
class Octokit::UnavailableForLegalReasons < ::Octokit::ClientError; end

# pkg:gem/octokit#lib/octokit/error.rb:332
class Octokit::UnprocessableEntity < ::Octokit::ClientError; end

# pkg:gem/octokit#lib/octokit/error.rb:329
class Octokit::UnsupportedMediaType < ::Octokit::ClientError; end

# pkg:gem/octokit#lib/octokit/error.rb:291
class Octokit::UnverifiedEmail < ::Octokit::Forbidden; end

# pkg:gem/octokit#lib/octokit/user.rb:5
class Octokit::User
  class << self
    # pkg:gem/octokit#lib/octokit/user.rb:10
    def path(user); end
  end
end

# pkg:gem/octokit#lib/octokit/version.rb:18
Octokit::VERSION = T.let(T.unsafe(nil), String)

# pkg:gem/octokit#lib/octokit/warnable.rb:5
module Octokit::Warnable
  private

  # pkg:gem/octokit#lib/octokit/warnable.rb:12
  def octokit_warn(*message); end

  class << self
    # pkg:gem/octokit#lib/octokit/warnable.rb:12
    def octokit_warn(*message); end
  end
end
