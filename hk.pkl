amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Holds buf output, which formatters must not rewrite.
local generated = List("gen/**")

local linters = new Mapping<String, Step> {
  ["rubocop"] {
    workspace_indicator = ".rubocop.yml"
    check = "cd {{workspace}} && bundle exec rubocop --force-exclusion {{ workspace_files }}"
    fix = "cd {{workspace}} && bundle exec rubocop --force-exclusion --autocorrect {{ workspace_files }}"
    batch = true
  }
  // srb typechecks the whole project at once, so no file list is passed.
  ["sorbet"] {
    glob = List("**/*.rb", "**/*.rbi", "sorbet/config", "Gemfile.lock")
    check = "bundle exec srb tc"
  }
  ["actionlint"] = Builtins.actionlint
  ["newlines"] = (Builtins.newlines) {
    exclude = generated
  }

  ["oxfmt"] {
    workspace_indicator = "pnpm-lock.yaml"
    glob = "**/*.{ts,tsx,js,jsx,css,sass,scss}"
    check = "cd {{workspace}} && npx oxfmt --check {{ workspace_files }}"
    check_list_files = "cd {{workspace}} && npx oxfmt --list-different {{ workspace_files }}"
    fix = "cd {{workspace}} && npx oxfmt --write {{ workspace_files }}"
    batch = true
  }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
